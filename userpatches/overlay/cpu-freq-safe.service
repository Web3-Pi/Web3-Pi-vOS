[Unit]
Description=CPU Frequency Safety Clamp (early boot)
DefaultDependencies=no
After=sysinit.target
Before=basic.target multi-user.target
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/web3pi/cpu-freq-safe.sh

[Install]
WantedBy=sysinit.target
