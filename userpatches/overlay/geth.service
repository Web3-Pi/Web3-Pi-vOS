[Unit]
Description=Geth Execution Layer Client
Documentation=https://geth.ethereum.org/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=el
Group=el
Restart=on-failure
RestartSec=120

# Geth needs time to flush state and close the database cleanly; the systemd
# default (90 s) then SIGKILLs it, which during snap sync loses the PBSS triedb
# journal and bricks the datadir ("missing trie node <genesis root>" Fatal on
# every restart, only cure is removedb + full resync). Seen on w3p-t1 and
# w3p-t2 2026-07-12/13.
TimeoutStopSec=600

# Working directory
WorkingDirectory=/var/lib/el

# Environment
Environment=HOME=/var/lib/el
EnvironmentFile=/opt/web3pi/config

# Geth command
# Adjust parameters as needed for your setup.
# Config vars use the W3P_ prefix: geth itself scans its environment for GETH_*
# names and maps them onto flags (GETH_PORT used to be silently applied, unknown
# ones logged "Unknown config environment variable"). W3P_* keeps our config out
# of geth's namespace.
# W3P_GETH_HISTORY_FLAG comes from the EnvironmentFile (/opt/web3pi/config) and
# holds the chain-history retention flag (e.g. --history.chain=postprague) or is
# empty. It is referenced WITHOUT braces on purpose: systemd word-splits $VAR, so
# an empty value expands to zero arguments. ${VAR} (braces) would instead pass a
# single empty "" argument and break geth startup. Do not add braces here.
# Change it via control-panel.sh -> Eth Network Configuration -> Geth Chain History.
ExecStart=/usr/bin/geth \
    --${W3P_NETWORK} \
    --datadir=/var/lib/el \
    --state.scheme=path \
    $W3P_GETH_HISTORY_FLAG \
    --port=${W3P_GETH_PORT} \
    --discovery.port=${W3P_GETH_PORT} \
    --http \
    --http.addr=127.0.0.1 \
    --http.port=8545 \
    --http.api=eth,net,web3 \
    --http.vhosts=localhost \
    --http.corsdomain=* \
    --ws \
    --ws.port=8546 \
    --ws.addr=127.0.0.1 \
    --ws.origins=localhost \
    --authrpc.addr=127.0.0.1 \
    --authrpc.port=8551 \
    --authrpc.vhosts=localhost \
    --authrpc.jwtsecret=/etc/web3pi/jwt.hex \
    --syncmode=snap \
    --cache=4096

# Memory limits (cgroups v2)
MemoryHigh=10G
#MemorySwapMax=4G

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/el

[Install]
WantedBy=multi-user.target
