[Unit]
Description=Geth Execution Layer Client
Documentation=https://geth.ethereum.org/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=el
Group=el
Restart=on-failure
RestartSec=120

# Working directory
WorkingDirectory=/var/lib/el

# Environment
Environment=HOME=/var/lib/el
EnvironmentFile=/opt/web3pi/config

# Geth command
# Adjust parameters as needed for your setup
ExecStart=/usr/bin/geth \
    --${NETWORK} \
    --datadir=/var/lib/el \
    --state.scheme=path \
    --port=30303 \
    --discovery.port=30303 \
    --http \
    --http.addr=127.0.0.1 \
    --http.port=8545 \
    --http.api=eth,net,web3 \
    --http.vhosts=localhost \
    --http.corsdomain=* \
    --ws \
    --ws.port=8546 \
    --ws.addr=0.0.0.0 \
    --ws.origins=localhost \
    --authrpc.addr=127.0.0.1 \
    --authrpc.port=8551 \
    --authrpc.vhosts=localhost \
    --authrpc.jwtsecret=/var/lib/el/jwt.hex \
    --syncmode=snap \
    --cache=8192

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/el

[Install]
WantedBy=multi-user.target
