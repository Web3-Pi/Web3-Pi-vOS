[Unit]
Description=Nimbus Beacon Node (Consensus Layer)
Documentation=https://nimbus.guide/
After=network-online.target geth.service
Wants=network-online.target
Requires=geth.service

[Service]
Type=simple
User=cl
Group=cl
Restart=on-failure
RestartSec=120

# Working directory
WorkingDirectory=/var/lib/cl

# Environment
Environment=HOME=/var/lib/cl
EnvironmentFile=/opt/web3pi/config

# Nimbus beacon node command
# Adjust parameters as needed for your setup
ExecStart=/usr/bin/nimbus_beacon_node \
    --network=${NETWORK} \
    --data-dir=/var/lib/cl \
    --el=http://127.0.0.1:8551 \
    --jwt-secret=/etc/web3pi/jwt.hex \
    --rest \
    --rest-address=127.0.0.1 \
    --rest-port=5052 \
    --rest-allow-origin='*' \
    --tcp-port=${NIMBUS_PORT} \
    --udp-port=${NIMBUS_PORT} \
    --enr-auto-update
    
# Soft memory ceiling: under prolonged non-finality the beacon's memory can
# balloon; reclaim pressure beats the OOM-killer picking it (M5 plan v2 §5.9).
# Percentage of physical RAM: product target is the 16 GB RPi5 (-> 8 GB ceiling),
# dev benches on 8 GB units get 4 GB automatically.
MemoryHigh=50%

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cl
ReadOnlyPaths=/etc/web3pi/jwt.hex

[Install]
WantedBy=multi-user.target
