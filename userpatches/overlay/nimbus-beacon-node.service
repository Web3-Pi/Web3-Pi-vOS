[Unit]
Description=Nimbus Beacon Node (Consensus Layer)
Documentation=https://nimbus.guide/
# mev-boost: ordering only (no Wants/Requires) — the beacon node must run even
# when MEV Boost is disabled, and falls back to local block production anyway.
After=network-online.target geth.service mev-boost.service
Wants=network-online.target
Requires=geth.service

[Service]
Type=simple
User=cl
Group=cl
Restart=on-failure
RestartSec=120

# Nimbus checkpoints its database on shutdown; under heavy backfill + swap this
# can exceed the systemd default 90 s and a SIGKILL mid-checkpoint risks a slow
# recovery on next start. Give it headroom.
TimeoutStopSec=300

# Working directory
WorkingDirectory=/var/lib/cl

# Environment
Environment=HOME=/var/lib/cl
EnvironmentFile=/opt/web3pi/config

# Nimbus beacon node command
# Adjust parameters as needed for your setup.
# W3P_MEV_BOOST_BN_FLAGS comes from the EnvironmentFile (/opt/web3pi/config):
# either "--payload-builder=true --payload-builder-url=http://127.0.0.1:18550"
# or empty. Referenced WITHOUT braces on purpose: systemd word-splits $VAR, so an
# empty value expands to zero arguments (same as W3P_GETH_HISTORY_FLAG in
# geth.service). Toggle via control-panel.sh -> Validator Management -> MEV Boost.
ExecStart=/usr/bin/nimbus_beacon_node \
    --network=${W3P_NETWORK} \
    --data-dir=/var/lib/cl \
    --el=http://127.0.0.1:8551 \
    --jwt-secret=/etc/web3pi/jwt.hex \
    --rest \
    --rest-address=127.0.0.1 \
    --rest-port=5052 \
    --rest-allow-origin='*' \
    --tcp-port=${W3P_NIMBUS_PORT} \
    --udp-port=${W3P_NIMBUS_PORT} \
    --enr-auto-update \
    $W3P_MEV_BOOST_BN_FLAGS

# Soft memory ceiling: under prolonged non-finality the beacon's memory can
# balloon; reclaim pressure beats the OOM-killer picking it (M5 plan v2 §5.9).
# Percentage of physical RAM: product target is the 16 GB RPi5 (-> 8 GB ceiling),
# dev benches on 8 GB units get 4 GB automatically.
MemoryHigh=50%

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cl
ReadOnlyPaths=/etc/web3pi/jwt.hex

[Install]
WantedBy=multi-user.target
