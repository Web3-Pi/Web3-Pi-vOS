[Unit]
Description=Nimbus Validator Client
Documentation=https://nimbus.guide/
After=network-online.target
Wants=network-online.target

# This service should only be started manually via unlock-validator.sh
# It requires the LUKS partition to be mounted first

[Service]
Type=simple
User=signer
Group=signer
Restart=on-failure
RestartSec=10

# Working directory is signer's home (on LUKS)
WorkingDirectory=/home/signer

# Environment
Environment=HOME=/home/signer
EnvironmentFile=/opt/web3pi/config

# Nimbus validator client command
# W3P_MEV_BOOST_VC_FLAGS comes from the EnvironmentFile (/opt/web3pi/config):
# either "--payload-builder=true" or empty. Required on the VC as well as the
# beacon node (nimbus.guide/external-block-builder.html); the builder URL goes
# only on the beacon node. Referenced WITHOUT braces on purpose: systemd
# word-splits $VAR, so an empty value expands to zero arguments.
ExecStart=/usr/bin/nimbus_validator_client \
    --data-dir=/home/signer/keys \
    --beacon-node=http://127.0.0.1:5052 \
    --suggested-fee-recipient=${W3P_FEE_RECIPIENT} \
    --graffiti=${W3P_GRAFFITI} \
    --log-level=INFO \
    $W3P_MEV_BOOST_VC_FLAGS

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/signer

[Install]
# Not enabled by default - started manually after LUKS unlock
WantedBy=multi-user.target
